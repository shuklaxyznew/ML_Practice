# ============================================================
# Multi-Agent Job Search Assistant — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ── LLM API Keys ────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Primary LLM provider: "openai" or "anthropic"
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# Embedding model
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072

# ── Database ────────────────────────────────────────────────
# SQLite (default for local dev)
DATABASE_URL=sqlite:///./data/jobsearch.db

# PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@localhost:5432/jobsearch

# ── Vector Store ────────────────────────────────────────────
# "faiss" or "chromadb"
VECTOR_STORE_TYPE=faiss
VECTOR_STORE_PATH=./vectorstore/faiss_index
CHROMA_PERSIST_DIR=./vectorstore/chroma

# ── Web Scraping ────────────────────────────────────────────
# Use headless browser: "true" or "false"
USE_HEADLESS_BROWSER=true
PLAYWRIGHT_BROWSER=chromium
SCRAPE_DELAY_MIN=2
SCRAPE_DELAY_MAX=5
MAX_JOBS_PER_SOURCE=50

# ── Job Search ──────────────────────────────────────────────
DEFAULT_SEARCH_KEYWORDS=Software Engineer,Python Developer,AI Engineer
DEFAULT_LOCATION=Remote
DEFAULT_EXPERIENCE_LEVELS=mid,senior
SALARY_CURRENCY=USD

# ── Email Notifications ─────────────────────────────────────
SENDGRID_API_KEY=SG.your-sendgrid-key-here
NOTIFICATION_EMAIL_FROM=noreply@yourdomain.com
NOTIFICATION_EMAIL_TO=your@email.com
ENABLE_EMAIL_NOTIFICATIONS=false

# ── Streamlit ────────────────────────────────────────────────
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# ── Application Settings ─────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./data/logs/app.log
MAX_RETRIES=3
REQUEST_TIMEOUT=30
BATCH_SIZE=10

# ── CrewAI Settings ──────────────────────────────────────────
CREW_VERBOSE=true
CREW_MAX_ITER=15
CREW_MEMORY=true

# ── Report Generation ────────────────────────────────────────
REPORT_OUTPUT_DIR=./data/reports
WEEKLY_REPORT_DAY=monday
WEEKLY_REPORT_TIME=09:00
