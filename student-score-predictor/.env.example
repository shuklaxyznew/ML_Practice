# ============================================================
# Student Score Predictor — Environment Configuration
# ============================================================
# Copy to .env and fill in what you need.
# You only need ONE LLM backend configured.
# NEVER commit .env to git.

# ── Which LLM backend to use ─────────────────────────────────
# Options: ollama | groq | huggingface | gemini | anthropic
LLM_BACKEND=ollama

# ── Ollama (RECOMMENDED — local, free, no API key) ───────────
# Install : https://ollama.ai
# Then run: ollama pull llama3.1       (4.7 GB, best quality)
#        or: ollama pull gemma2:2b      (1.6 GB, lightweight)
#        or: ollama pull mistral        (4.1 GB, balanced)
OLLAMA_MODEL=llama3.1

# ── Groq (free cloud, Llama 3.1 70B, very fast) ─────────────
# Sign up: https://console.groq.com
# GROQ_API_KEY=gsk_your_key_here
# GROQ_MODEL=llama-3.1-70b-versatile

# ── HuggingFace (free cloud, many open models) ───────────────
# Sign up: https://huggingface.co → Settings → Access Tokens
# HF_API_KEY=hf_your_token_here
# HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# ── Google Gemini (free tier) ────────────────────────────────
# Get key: https://aistudio.google.com
# GEMINI_API_KEY=your_key_here

# ── Anthropic Claude (paid) ──────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Model Serving ────────────────────────────────────────────
MODEL_PATH=checkpoints/best_model
SCALER_PATH=artifacts/scaler.pkl
