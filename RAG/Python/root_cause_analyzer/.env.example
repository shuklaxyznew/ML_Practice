# ── LLM Keys (set at least one) ──────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# ── Vector DB ────────────────────────────────────────────────────────────────
# ChromaDB (local, default — no extra config needed)
CHROMA_PERSIST_DIR=./data/chroma

# Pinecone (production alternative)
# PINECONE_API_KEY=your_pinecone_key
# PINECONE_INDEX=root-cause-incidents

# ── Optional: Elasticsearch for log ingestion ─────────────────────────────────
# ELASTICSEARCH_URL=http://localhost:9200
# ELASTICSEARCH_INDEX=app-logs

# ── App settings ──────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=info
